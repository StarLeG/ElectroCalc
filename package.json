{
  "name": "engicalc",
  "version": "1.0.0",
  "private": true,
  "description": "Сборка страниц и тесты веб-версии EngiCalc. Сайт работает без зависимостей; Playwright нужен только для браузерных тестов.",
  "type": "module",
  "scripts": {
    "build": "node tools/build-pages.mjs",
    "check": "node tools/check-pages.mjs",
    "prepare-deploy": "node tools/build-pages.mjs && node tools/check-pages.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --import ./tests/web/unit/setup.mjs \"tests/web/unit/**/*.test.mjs\"",
    "test:e2e": "node tools/build-pages.mjs && playwright test -c tests/web/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
