# ===== Сгенерированные страницы веб-версии =====
# Собираются из web/_master.html скриптом tools/build-pages.mjs.
# В историю не идут: одна правка мастера меняла бы полсотни файлов разом.
# Перед выкладкой: npm run build (deploy-web.ps1 проверяет свежесть сам).
web/index.html
web/*/index.html
web/404.html
web/sitemap.xml
